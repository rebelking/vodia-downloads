{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MarketplaceRead",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:SearchListings",
        "aws-marketplace:GetProduct",
        "aws-marketplace:ListFulfillmentOptions",
        "aws-marketplace:ListPurchaseOptions",
        "aws-marketplace:GetOffer",
        "aws-marketplace:GetOfferTerms",
        "aws-marketplace:SearchAgreements",
        "aws-marketplace:DescribeAgreement",
        "aws-marketplace:GetAgreementTerms",
        "aws-marketplace:GetAgreementEntitlements",
        "aws-marketplace:ViewSubscriptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MarketplacePurchaseVodiaOnly",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:CreateAgreementRequest",
        "aws-marketplace:AcceptAgreementRequest"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws-marketplace:ProductId": [
            "prod-v5qnz6xf6wu5u"
          ]
        }
      }
    },
    {
      "Sid": "EC2ReadLaunchAndTerminateVodia",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceTypes",
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:TerminateInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassVodiaEntitlementRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/VodiaPBXMarketplaceEntitlementRole"
    },
    {
      "Sid": "LicenseManagerRead",
      "Effect": "Allow",
      "Action": [
        "license-manager:ListReceivedLicenses",
        "license-manager:GetLicense"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CreateLicenseManagerServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/license-manager.amazonaws.com/AWSServiceRoleForAWSLicenseManagerRole*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "license-manager.amazonaws.com"
        }
      }
    }
  ]
}
